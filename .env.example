# MeetSync Platform Environment Configuration

# Database
# For SQLite (instant local run): sqlite+aiosqlite:///./data/meetsync.db
# For PostgreSQL (Docker / Production): postgresql+asyncpg://meetsync:meetsync_secret@localhost:5432/meetsync
DATABASE_URL=sqlite+aiosqlite:///./data/meetsync.db

# AI & Speech Models
# Optional for local test/demo (fallback deterministic parser is built-in)
# Required for OpenAI Whisper & GPT extraction
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Application
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api

# Frontend Proxy
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
